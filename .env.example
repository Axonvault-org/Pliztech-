# Plz mobile app — copy to `.env` and restart Expo after changes.
# Production values are set in EAS secrets / build profiles.

# Backend API (no trailing slash)
# - iOS Simulator / web: http://localhost:3000
# - Android emulator: same — app maps localhost → 10.0.2.2 automatically
# - Physical phone on Wi‑Fi: http://YOUR_MAC_LAN_IP:3000 (backend must be running)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Web app origin for payment checkout redirect (must match backend FRONTEND_URL)
# Required for Vercel/static web builds — set in Vercel project env for production:
#   EXPO_PUBLIC_FRONTEND_URL=https://app.plz.ng
EXPO_PUBLIC_FRONTEND_URL=http://localhost:8081

# Optional alias used by some payment/community modules when FRONTEND_URL is unset
# EXPO_PUBLIC_WEB_APP_URL=https://app.plz.ng

# Google Sign-In (Web client ID from Google Cloud Console — public, not a secret)
# Must match backend GOOGLE_CLIENT_ID when SOCIAL_OAUTH_ENABLED is true.
# Set in EAS secrets for staging/production builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Sign-In iOS URL scheme (reversed iOS OAuth client ID from Google Cloud Console).
# Example: com.googleusercontent.apps.123456789-abcdefg
# Required for native Google Sign-In on iOS builds; set in EAS secrets for staging/production.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
